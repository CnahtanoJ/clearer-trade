# ==============================================================================
# CLEARER.TRADE — OPEN SOURCE TRADING JOURNAL CONFIGURATION
# ==============================================================================
# All core trading analytics, metrics, charts, and tick sync work 100% statelessly
# out of the box with zero configuration!
#
# Copy this file to .env for local development:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. OPTIONAL: AI BEHAVIORAL AUDIT (BYOK / SERVER-LEVEL FALLBACK)
# ------------------------------------------------------------------------------
# clearer.trade is pure BYOK (Bring Your Own Key). Users can enter their personal
# OpenRouter API key directly in the web UI.
# If you are self-hosting and want to provide a default server-side fallback key,
# set it below:
OPENROUTER_API_KEY=

# Optional: Default OpenRouter model ID
# Options: deepseek/deepseek-chat, google/gemini-2.5-flash, anthropic/claude-3.5-sonnet, etc.
# DEFAULT_AI_MODEL=deepseek/deepseek-chat

# ------------------------------------------------------------------------------
# 2. OPTIONAL: SERVER SETTINGS & CORS
# ------------------------------------------------------------------------------
# Allowed CORS origins for the FastAPI backend (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. OPTIONAL: NEXT.JS FRONTEND API URL
# ------------------------------------------------------------------------------
# Leave empty on Vercel to use relative serverless routes (/api/*).
# For separate local backend/frontend development, set to http://localhost:8000:
# NEXT_PUBLIC_API_URL=http://localhost:8000
