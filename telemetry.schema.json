{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearer.trade/schemas/telemetry.schema.json",
  "title": "clearer.trade Execution Telemetry Contract",
  "description": "Zero-leakage, T+24h delayed, SHA-256 attested post-trade execution telemetry schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "equity_curve",
    "execution_hygiene",
    "anonymized_baskets"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "node_id",
        "last_updated_utc",
        "attestation_sha256"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "node_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "last_updated_utc": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 UTC timestamp enforcing at least a T+24h publication delay."
        },
        "attestation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Daily SHA-256 pre-commitment hash of canonical raw ledger + LEDGER_SALT."
        },
        "region": {
          "type": "string",
          "maxLength": 32
        },
        "publication_delay_hours": {
          "type": "integer",
          "minimum": 24
        },
        "tick_stagger_bucket_ms": {
          "type": "integer",
          "minimum": 0
        },
        "decorrelation_cohort": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "equity_curve": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "twr_index",
          "daily_return_pct"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "twr_index": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "daily_return_pct": {
            "type": "number"
          }
        }
      }
    },
    "execution_hygiene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maker_fill_ratio",
        "avg_mae_bps",
        "avg_mfe_bps",
        "adverse_drift_bps",
        "total_fills_bucketed"
      ],
      "properties": {
        "maker_fill_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "avg_mae_bps": {
          "type": "number",
          "minimum": 0
        },
        "avg_mfe_bps": {
          "type": "number",
          "minimum": 0
        },
        "adverse_drift_bps": {
          "type": "number"
        },
        "total_fills_bucketed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "anonymized_baskets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_alias",
          "fill_share_pct",
          "avg_mae_bps"
        ],
        "properties": {
          "asset_alias": {
            "type": "string",
            "pattern": "^Asset_[A-Z]+$"
          },
          "fill_share_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "avg_mae_bps": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
